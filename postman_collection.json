    {
      "name": "3. Families Directory & 360",
      "item": [
        {
          "name": "List Families (with Filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/families?search=&area=Station Road&engagement=High",
              "host": ["{{baseUrl}}"],
              "path": ["api", "families"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "area", "value": "Station Road" },
                { "key": "engagement", "value": "High" }
              ]
            }
          }
        },
        {
          "name": "Register New Household",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vora Family (Ashokbhai)\",\n  \"gujaratiName\": \"વોરા પરિવાર\",\n  \"captainName\": \"Ashokbhai Vora\",\n  \"phone\": \"9825044556\",\n  \"address\": \"12, Vallabh Park, Petlad Road\",\n  \"area\": \"Petlad Road\",\n  \"zone\": \"West Nadiad\",\n  \"notes\": \"Regular contributors to Seva activities\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/families",
              "host": ["{{baseUrl}}"],
              "path": ["api", "families"]
            }
          }
        },
        {
          "name": "Log Touchpoint / Interaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interactionType\": \"Home Visit\",\n  \"notes\": \"Visited with Mahaprasad; family confirmed upcoming Sabha attendance.\",\n  \"requiresFollowUp\": false\n}"
