{
  "info": {
    "_postman_id": "harisumiran-nadiad-api-v2",
    "name": "HariSumiran Mandir Operations API",
    "description": "Comprehensive RESTful API collection for HariSumiran (HariPrabodham, Nadiad) covering Auth, Families, Members, Sabha Attendance, Follow-Up, Seva, Assets, Events, Thal Rotation, and Admin settings.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "demo_jwt_token_harisumiran",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth & Session",
      "item": [
        {
          "name": "Send OTP (Mobile/Email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"send_otp\",\n  \"phone\": \"9825023456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth"]
            }
          }
        },
        {
          "name": "Verify OTP (Code 123456)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"verify_otp\",\n  \"phone\": \"9825023456\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth"]
            }
          }
        },
        {
          "name": "Switch Persona Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"switch_role\",\n  \"role\": \"karyakarta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth"]
            }
          }
        }
      ]
    },
