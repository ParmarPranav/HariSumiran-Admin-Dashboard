            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gujarati Shrikhand & Puri\",\n  \"gujaratiName\": \"ગુજરાતી શ્રીખંડ અને પૂરી\",\n  \"category\": \"Dessert & Bread\",\n  \"description\": \"Traditional festive Mahaprasad recipe\",\n  \"prepTimeMinutes\": 60,\n  \"ingredients\": [\n    {\n      \"name\": \"Chakka (Hung Curd)\",\n      \"gujaratiName\": \"ચક્કો (દહીં)\",\n      \"quantityPer10People\": 1.5,\n      \"unit\": \"kg\",\n      \"notes\": \"Fresh buffalo curd\"\n    },\n    {\n      \"name\": \"Pure Sugar\",\n      \"gujaratiName\": \"ખાંડ\",\n      \"quantityPer10People\": 1.0,\n      \"unit\": \"kg\"\n    },\n    {\n      \"name\": \"Wheat Flour (Gehu Atta)\",\n      \"gujaratiName\": \"ઘઉંનો લોટ\",\n      \"quantityPer10People\": 1.2,\n      \"unit\": \"kg\"\n    }\n  ],\n  \"preparationInstructions\": [\n    \"Whip chakka with powdered sugar until smooth and glossy.\",\n    \"Add cardamom and saffron soaked in warm milk.\",\n    \"Roll out puris and fry in pure ghee or groundnut oil.\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/kitchen/recipes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kitchen", "recipes"]
            }
          }
        },
